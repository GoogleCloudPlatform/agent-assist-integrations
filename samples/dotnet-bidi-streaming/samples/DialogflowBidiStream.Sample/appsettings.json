{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning",
      "DialogflowBidiStream": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "DialogflowStreaming": {
    "ProjectId": "YOUR_GCP_PROJECT_ID",
    "LocationId": "global",
    "ConversationProfileName": "projects/YOUR_GCP_PROJECT_ID/locations/global/conversationProfiles/YOUR_PROFILE_ID",
    "DefaultSampleRateHertz": 8000,
    "DefaultAudioEncoding": "Mulaw",
    "MaxLookbackSeconds": 1.5,
    "RestartThreshold": "00:14:30",
    "MaxStreamLifetime": "00:14:50",
    "AutoCompleteConversationOnDisconnect": true,
    "EnableDebugLogging": true
  }
}
