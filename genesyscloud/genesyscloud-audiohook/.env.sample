CONVERSATION_PROFILE_NAME=projects/{your-project-id}/locations/{your-service-region}/conversationProfiles/{your-conversation-profile-name}
GCP_PROJECT_ID={your-project-id}
API_KEY={api-key-from-genesys}
SERVICE_ACCOUNT={your-service-account-name}
UI_CONNECTOR={your-agent-assist-backend-domain-name}
VOICE_INTERCEPTOR_SERVICE={your-voice-interceptor-service-name}
VPC_CONNECTOR_NAME={your-vpc-connector-name}
SERVICE_REGION={your-service-region}
CLOUD_RUN_SERVICE_REGION={your-cloud-run-service-region}
REDIS_INSTANCE_ID={your-redis-instance-id}
# Progressive upgrade: set REDIS_TLS_ENABLED=true when Memorystore has
# SERVER_AUTHENTICATION in-transit encryption enabled (port 6378).
REDIS_TLS_ENABLED=false
REDIS_CA_CERT_SECRET_NAME=aa-integration-redis-ca-cert